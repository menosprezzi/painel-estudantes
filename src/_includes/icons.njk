{% macro icon(name) -%}
<svg class="icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if name == 'users' -%}
  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  {%- elif name == 'terminal' -%}
  <path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>
  {%- elif name == 'code' -%}
  <path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>
  {%- elif name == 'calendar' -%}
  <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
  {%- elif name == 'music' -%}
  <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
  {%- elif name == 'download' -%}
  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>
  {%- elif name == 'git-branch' -%}
  <path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>
  {%- elif name == 'plus' -%}
  <path d="M12 5v14"/><path d="M5 12h14"/>
  {%- elif name == 'check' -%}
  <path d="m20 6-11 11-5-5"/>
  {%- elif name == 'upload' -%}
  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/>
  {%- endif -%}
</svg>
{%- endmacro %}
